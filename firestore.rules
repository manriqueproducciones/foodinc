rules_version = '2';

// Pegá esto en Firebase Console → Firestore Database → Reglas → Publicar.
// Regla simple: cada usuario autenticado solo puede leer y escribir
// dentro de su propia carpeta users/{su_uid}/... Nadie puede ver ni tocar
// los datos de otro usuario, ni siquiera estando logueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
